# Conexão usada pelo site.
# Supabase: Connect > Transaction pooler (porta 6543) + "?pgbouncer=true&connection_limit=1&schema=crm"
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1&schema=crm"
# Conexão usada para criar e atualizar as tabelas (prisma migrate).
# Supabase: Connect > Session pooler (porta 5432) + "?schema=crm". Em PostgreSQL próprio, repita a DATABASE_URL.
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres?schema=crm"
# Segredo para assinar a sessão. Gere com: openssl rand -hex 32
AUTH_SECRET=""
